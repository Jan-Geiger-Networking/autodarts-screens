{
  "name": "autodarts-screens",
  "version": "0.1.0-beta.17",
  "description": "Zwei Vollbildschirme fuer Autodarts-Matches: Spielerinfo neben der Scheibe, Broadcast-Ansicht fuer Zuschauer",
  "author": "Jan Geiger Networking <hey@bsbnet.eu>",
  "license": "MIT",
  "repository": "github:Jan-Geiger-Networking/autodarts-screens",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "eu.jgnet.autodarts-screens",
    "productName": "Autodarts Dual-Screen",
    "copyright": "Copyright (c) 2026 Jan Geiger Networking",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Jan-Geiger-Networking",
        "repo": "autodarts-screens"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json",
      "CHANGELOG.md",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Autodarts Dual-Screen"
    },
    "artifactName": "${name}-Setup-${version}.${ext}"
  }
}
